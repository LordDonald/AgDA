# ============================================================
# AgDA Web Environment Contract
# ============================================================
# See docs/environment_contract.md in the repository root.
# These settings are server-only; never prefix them with NEXT_PUBLIC_.
# Keep real tokens in environment-specific deployment secrets.

# FastAPI address used only by the Next.js server.
#
# Development:
# This variable is optional. If omitted, AgDA uses:
# http://127.0.0.1:8000
#
# NODE_ENV=production (including hosted staging):
# This variable is required and must point to this environment's API.
#
# Local example:
AGDA_API_URL=http://127.0.0.1:8000

# Hosted example:
# AGDA_API_URL=https://api.example.com

# Secret forwarded by the web server to internal backend analytics.
# Must match this environment's API AGDA_INTERNAL_ANALYTICS_TOKEN.
# Blank disables the configured dashboard's backend proxy with HTTP 503.
AGDA_INTERNAL_ANALYTICS_TOKEN=

# Separate secret entered by the dashboard operator.
# Blank disables dashboard access with HTTP 401.
# Keep distinct from analytics/operations tokens and from the other environment.
AGDA_INTERNAL_DASHBOARD_TOKEN=

# Do not configure Redis, database, or operations credentials on the web service.
# Preserve blank production API/web repository sources for manual-only deploys.
