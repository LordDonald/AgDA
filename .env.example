# ============================================================
# AgDA Backend Environment Contract
# ============================================================

# Runtime environment:
# development | test | staging | production
AGDA_ENV=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
AGDA_LOG_LEVEL=INFO

# Maximum number of in-process conversation contexts
AGDA_MAX_CONVERSATIONS=500

# Maximum HTTP request body size in bytes
AGDA_MAX_REQUEST_BYTES=16384

# Swagger / OpenAPI documentation
AGDA_DOCS_ENABLED=true

# Comma-separated FastAPI Host headers that are allowed.
# Development/test default to unrestricted.
# Production/staging should list actual deployment hostnames.
AGDA_ALLOWED_HOSTS=localhost,127.0.0.1

# Service metadata
AGDA_SERVICE_NAME=AgDA API
AGDA_SERVICE_VERSION=0.1.0