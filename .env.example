# ============================================================
# AgDA Backend Environment Contract
# ============================================================
# Development examples only; see docs/environment_contract.md.
# Hosted configuration and validation evidence: docs/phase29_closure.md.
# Keep real credentials in environment-specific deployment secrets.

# Runtime environment:
# development | test | staging | production
AGDA_ENV=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
AGDA_LOG_LEVEL=INFO

# Maximum conversation-store capacity
AGDA_MAX_CONVERSATIONS=500

# memory | redis. Memory loses conversations on restart.
# Redis requires a reachable AGDA_REDIS_URL and is checked at API startup.
AGDA_CONVERSATION_BACKEND=memory

# Positive Redis conversation retention period in seconds.
AGDA_CONVERSATION_TTL_SECONDS=86400

# Secret Redis connection URL; required only when backend=redis.
# Use a dedicated staging resource, never a production reference in staging.
AGDA_REDIS_URL=

# Secret PostgreSQL URL; blank disables optional analytics persistence.
# Provision the analytics schema and use separate staging/production databases.
# Analytics rows do not carry an environment discriminator.
AGDA_ANALYTICS_DATABASE_URL=

# Secret for internal analytics reads; blank disables the read endpoints.
# These endpoints also require AGDA_ANALYTICS_DATABASE_URL.
# Match the web server's token in this environment; keep other roles distinct.
AGDA_INTERNAL_ANALYTICS_TOKEN=

# Maximum HTTP request body size in bytes
AGDA_MAX_REQUEST_BYTES=16384

# Swagger / ReDoc / OpenAPI documentation.
# Set false in production; this explicit development value overrides its default.
AGDA_DOCS_ENABLED=true

# Comma-separated FastAPI Host headers that are allowed.
# Development/test default to unrestricted.
# Production/staging should list actual deployment hostnames.
AGDA_ALLOWED_HOSTS=localhost,127.0.0.1

# Service metadata
AGDA_SERVICE_NAME=AgDA API
AGDA_SERVICE_VERSION=0.1.0

# Optional privileged token for internal operational mutation endpoints.
# Keep this secret in staging/production; blank disables those endpoints.
# Match this environment's scheduler token, not the analytics/dashboard tokens.
# Use a different operations token in staging and production.
AGDA_OPERATIONS_TOKEN=

# Operational-tool setting: full absolute HTTP(S) runtime reload endpoint.
# Required by refresh_and_reload_external_source.py unless --reload-url is set.
AGDA_OPERATIONS_RELOAD_URL=

# Operational-tool setting: full absolute HTTP(S) privileged refresh endpoint.
# Required by trigger_external_refresh.py unless --refresh-url is set.
# Both operational commands require AGDA_OPERATIONS_TOKEN.
AGDA_OPERATIONS_REFRESH_URL=

# Optional FEWS provenance: blank disables local snapshot restoration.
# Set an absolute path outside data/releases to the store created by ingestion.
# Startup and explicit reload read local snapshots only; neither makes HTTP calls.
AGDA_FEWS_SNAPSHOT_PATH=

# AgDA local retrieval age policy; this does not imply FEWS publishes every 48h.
AGDA_FEWS_STALE_AFTER_HOURS=48

# Optional Open-Meteo forecast provenance: blank disables local snapshot restoration.
# Set an absolute path outside data/releases to the store created by ingestion.
# Startup and explicit reload read local snapshots only; neither makes HTTP calls.
AGDA_WEATHER_SNAPSHOT_PATH=

# AgDA local retrieval age policy; this does not represent forecast accuracy,
# forecast-valid age, or ECMWF model issue age.
AGDA_WEATHER_STALE_AFTER_HOURS=6
